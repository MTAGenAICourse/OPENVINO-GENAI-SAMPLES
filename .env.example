# Copy this file to .env and fill in your own values.
# .env is in .gitignore -- never commit real keys.
#
# Labs 2-5 (local OpenVINO) need NO keys at all.

# --- Lab 1a: GPT-6.1 Sol on Microsoft Foundry (Azure OpenAI v1 API) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol

# --- Lab 1b: Claude Opus 5.5 (Anthropic API) ---
ANTHROPIC_API_KEY=<your-claude-key>

# --- Labs 6-8: agent samples that use Azure OpenAI as the "brain" ---
# (optional -- 09/10 can switch to a local OpenVINO model instead)
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_LLM_4=<your-deployment-name>
